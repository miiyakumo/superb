<Window x:Class="Superb.Desktop.ReaderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Superb.Desktop" Style="{StaticResource {x:Type Window}}" Title="Superb" Width="600" Height="740" MinWidth="360" MinHeight="480" MaxWidth="1800" MaxHeight="1600" AllowsTransparency="True" ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStyle="None" ResizeMode="NoResize" Background="Transparent" PreviewKeyDown="Window_PreviewKeyDown">
<Window.Resources><DataTemplate x:Key="ShortcutCaption"><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding}" HorizontalAlignment="Center" TextWrapping="NoWrap"/><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=(local:ShortcutHint.Text)}" ToolTip="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=(local:ShortcutHint.Description)}" Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}" FontFamily="Segoe UI" FontSize="10" MaxWidth="120" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></DataTemplate><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="5,4"/><Setter Property="ContentTemplate" Value="{StaticResource ShortcutCaption}"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="Margin" Value="0,0,4,6"/><Setter Property="FontSize" Value="12"/></Style><Style x:Key="WorkspacePrimary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Padding" Value="5,4"/><Setter Property="ContentTemplate" Value="{StaticResource ShortcutCaption}"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="Margin" Value="0,0,4,6"/><Setter Property="FontSize" Value="12"/></Style><Style TargetType="ScrollViewer"><Setter Property="Focusable" Value="False"/></Style><Style TargetType="Thumb"><Setter Property="Focusable" Value="False"/></Style><Style TargetType="ToggleButton"><Setter Property="Focusable" Value="False"/></Style></Window.Resources>
<Border x:Name="WindowSurface" Background="{StaticResource Base}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12"><Grid x:Name="WorkspaceRoot"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel x:Name="DragHeader" ToolTip="拖动标题移动浮窗，保持原窗口焦点。" MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
        <WrapPanel DockPanel.Dock="Right"><Button x:Name="InteractionButton" Content="编辑" Click="Interaction_Click" Padding="10,4" Focusable="False"/><Button x:Name="AppearanceButton" Content="外观" Click="Appearance_Click" Padding="8,4" Focusable="False"/><Button x:Name="SettingsButton" Content="设置" ToolTip="显示设置不抢焦点；点击设置窗口进行配置会使原窗口失焦。" Click="Settings_Click" Padding="10,4" Focusable="False"/><Button x:Name="HideButton" Content="收起" ToolTip="收起浮窗；若浮窗当前有焦点，Windows 会把焦点转给其他窗口。" Click="Hide_Click" Padding="10,4" Focusable="False"/></WrapPanel>
        <TextBlock Text="SUPERB" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>

<StackPanel Grid.Row="1" Margin="0,2,0,6">
        <TextBlock x:Name="StateText" Text="等待输入" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="ReceiverText" Text="先连接模型" MaxHeight="30" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
        <TextBlock x:Name="ModeHint" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Text="阅读模式 · 不主动切换焦点" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>

<Border x:Name="AppearancePanel" Grid.Row="2" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="0,4" Margin="0,0,0,6"><ScrollViewer x:Name="AppearanceScroll" VerticalScrollBarVisibility="Auto" MaxHeight="142" ToolTip="点击或拖动调整外观；程序不主动切换焦点。"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="{Binding ElementName=PanelWidth, Path=Value, StringFormat=宽度 {0:F0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelWidth" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="0" Grid.Column="1" Minimum="360" Maximum="1800" Value="600" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="浮窗宽度" ToolTip="拖动调整宽度；保持原窗口焦点，无需进入编辑。"/>
<TextBlock Grid.Row="1" Text="{Binding ElementName=PanelHeight, Path=Value, StringFormat=高度 {0:F0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelHeight" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="1" Grid.Column="1" Minimum="480" Maximum="1600" Value="740" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="浮窗高度" ToolTip="拖动调整高度；保持原窗口焦点，无需进入编辑。"/>
<TextBlock Grid.Row="2" Text="{Binding ElementName=PanelOpacity, Path=Value, StringFormat=不透明 {0:P0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelOpacity" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="2" Grid.Column="1" Minimum="0.25" Maximum="1" Value="1" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="浮窗背景不透明度" ToolTip="向右更不透明，文字保持实色；保持原窗口焦点，无需进入编辑。"/>
<TextBlock Grid.Row="3" Text="{Binding ElementName=PanelTextSize, Path=Value, StringFormat=字号 {0:F0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelTextSize" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="3" Grid.Column="1" Minimum="11" Maximum="36" Value="18" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="回答字号" ToolTip="拖动调整字号；保持原窗口焦点，无需进入编辑。"/></Grid><WrapPanel><Button x:Name="ComfortableButton" Content="舒适阅读" ToolTip="应用舒适阅读布局；保持原窗口焦点。" Click="Comfortable_Click" Focusable="False"/><Button x:Name="ResetAppearanceButton" Content="恢复默认" ToolTip="恢复默认外观；保持原窗口焦点。" Click="ResetAppearance_Click" Focusable="False"/></WrapPanel></StackPanel></ScrollViewer></Border>
<Grid x:Name="WorkArea" Grid.Row="3" SizeChanged="WorkArea_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Expander x:Name="ComposerExpander" IsExpanded="True" Margin="0,0,0,6"><Expander.Header><TextBlock x:Name="InputHeading" Text="输入与队列" FontSize="12"/></Expander.Header><ScrollViewer x:Name="ComposerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220"><StackPanel Margin="0,6,4,0">
        <DockPanel><TextBlock Text="场景" VerticalAlignment="Center" Margin="0,0,12,8"/><ComboBox x:Name="WorkspaceScene" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="WorkspaceScene_SelectionChanged" Focusable="False" AutomationProperties.Name="当前场景" ToolTip="鼠标选择场景，保持原窗口焦点；键盘配置场景请打开设置。"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="Focusable" Value="False"/></Style></ComboBox.ItemContainerStyle></ComboBox></DockPanel>
        <TextBox x:Name="DraftText" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="110" VerticalScrollBarVisibility="Auto" TextChanged="DraftText_TextChanged" PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown" AutomationProperties.Name="本次问题或补充要求" ToolTip="输入和输入法必须取得键盘焦点，会使原窗口失焦；Ctrl+Enter 发送。Esc 仅结束编辑，不自动返回原窗口。"/>
        <Border x:Name="Attachment" Visibility="Collapsed" Background="{StaticResource Surface}" Padding="8" Margin="0,0,0,8"><StackPanel>
          <DockPanel Margin="0,0,0,4"><Button x:Name="ClearInputButton" DockPanel.Dock="Right" Content="清空队列" Padding="6,1" Margin="0" Click="RemoveInput_Click" Focusable="False"/><TextBlock x:Name="QueueCount" VerticalAlignment="Center" FontSize="12"/></DockPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="110"><ItemsControl x:Name="InputQueue"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="150" Margin="0,0,10,0"><DockPanel><Button Content="移除" Tag="{Binding Id}" local:ShortcutHint.Text="{Binding RemoveHint}" local:ShortcutHint.Description="{Binding RemoveDescription}" DockPanel.Dock="Right" Padding="4,0" Margin="4,0,0,0" FontSize="11" Focusable="False" Click="RemoveInput_Click"/><TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel><Image Source="{Binding Thumbnail}" Visibility="{Binding ImageVisibility}" Height="40" Stretch="Uniform" HorizontalAlignment="Left"/><TextBlock Text="{Binding Summary}" FontSize="11" MaxHeight="28" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></Expander>
<WrapPanel Grid.Row="1"><Button x:Name="SendButton" Content="发送" Style="{StaticResource WorkspacePrimary}" Click="Send_Click" Focusable="False"/><Button x:Name="ClipboardButton" Content="读剪贴板" Click="Clipboard_Click" Focusable="False"/><Button x:Name="CaptureButton" Content="两点截图" ToolTip="选点不会激活底层窗口。采集时临时隐藏 Superb；若 Superb 当前有焦点，Windows 会转移焦点。建议先点击目标应用，再用截图快捷键。" Click="Capture_Click" Focusable="False"/><Button x:Name="ScreenButton" Content="截当前屏" ToolTip="采集时临时隐藏 Superb；若 Superb 当前有焦点，Windows 会转移焦点。建议先点击目标应用，再用截图快捷键。" Click="Screen_Click" Focusable="False"/><Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Focusable="False"/></WrapPanel>

<Border x:Name="AnswerSurface" Grid.Row="2" ClipToBounds="True" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="回答" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/><Grid><TextBlock x:Name="EmptyAnswer" Text="选择场景，输入问题或收集截图、剪贴板。&#10;确认队列后发送。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/><local:AnswerView x:Name="Answer" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" FontSize="18" ToolTip="阅读、翻页和滚动保持原窗口焦点；编辑模式下拖选文字需要焦点，会使原窗口失焦。可用“复制回答”避免切换。"/></Grid></DockPanel></Border>

</Grid>
<StackPanel Grid.Row="4"><WrapPanel><Button x:Name="CopyButton" Content="复制回答" Click="Copy_Click" IsEnabled="False" Focusable="False"/><Button x:Name="RetryButton" Content="重答" ToolTip="沿用上次冻结的输入、场景、模型、token 上限和思考设置；修改设置后请使用发送" Click="Retry_Click" IsEnabled="False" Focusable="False"/><Button x:Name="DirectRetryButton" Content="直接回答重试" Visibility="Collapsed" ToolTip="仅这次重试关闭 DeepSeek 深度思考，可能产生新的用量；保持上次输入、模型、token 上限与保护规则，不修改保存的设置" Click="DirectRetry_Click" Focusable="False"/><Button Content="新任务" Click="NewTask_Click" Focusable="False"/><Button x:Name="ThroughButton" Content="穿透" ToolTip="只把鼠标操作交给底层窗口，不自动转移键盘焦点；请点击目标应用继续输入。" Click="Through_Click" Focusable="False"/><Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" Focusable="False"/></WrapPanel><DockPanel><Thumb x:Name="ResizeHandle" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" DockPanel.Dock="Right" Width="24" Height="20" Cursor="SizeNWSE" DragDelta="ResizeHandle_DragDelta" AutomationProperties.Name="拖动调整浮窗大小" ToolTip="拖动调整大小；保持原窗口焦点，无需进入编辑。"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><TextBlock Text="◢" Foreground="{StaticResource Accent}" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border></ControlTemplate></Thumb.Template></Thumb><TextBlock x:Name="ProtectionStatus" Text="保护未验证" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></StackPanel>
</Grid></Border></Window>

<Window x:Class="Superb.Desktop.ReaderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Superb.Desktop" Style="{StaticResource {x:Type Window}}" Title="Superb" Width="600" Height="740" MinWidth="360" MinHeight="480" MaxWidth="1800" MaxHeight="1600" AllowsTransparency="True" ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStyle="None" ResizeMode="NoResize" Background="Transparent">
<Window.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,3"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="Margin" Value="0,0,2,2"/><Setter Property="FontSize" Value="12"/></Style><Style x:Key="WorkspacePrimary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="{DynamicResource WorkspaceAccentBackground}"/><Setter Property="Padding" Value="8,3"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="Margin" Value="0,0,2,2"/><Setter Property="FontSize" Value="12"/></Style><Style TargetType="ScrollViewer"><Setter Property="Focusable" Value="False"/></Style><Style TargetType="Thumb"><Setter Property="Focusable" Value="False"/></Style><Style TargetType="ToggleButton"><Setter Property="Focusable" Value="False"/></Style></Window.Resources>
<Border x:Name="WindowSurface" Background="{DynamicResource Base}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10"><Grid x:Name="WorkspaceRoot"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel x:Name="DragHeader" ToolTip="拖动标题移动浮窗，保持原窗口焦点。" MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><Button x:Name="SettingsButton" Content="程序设置" ToolTip="显示程序设置不抢焦点；点击设置窗口配置模型、场景和偏好会使原窗口失焦。" Click="Settings_Click" Focusable="False"/><Button x:Name="HideButton" Content="收起" ToolTip="收起浮窗；若浮窗当前有焦点，Windows 会把焦点转给其他窗口。" Click="Hide_Click" Focusable="False"/></WrapPanel>
        <Grid VerticalAlignment="Center" Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="240"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="StateText" TextWrapping="NoWrap" Text="等待输入" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="·" Margin="6,0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="ReceiverText" TextWrapping="NoWrap" Grid.Column="2" Text="先连接模型" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/></Grid>
      </DockPanel>
<TextBlock x:Name="ModeHint" Grid.Row="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Text="" Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,6"/>

<Grid x:Name="WorkArea" Grid.Row="2" Grid.RowSpan="2" SizeChanged="WorkArea_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Expander x:Name="ComposerExpander" IsExpanded="True" Margin="0,0,0,6"><Expander.Header><TextBlock x:Name="InputHeading" Text="材料队列" FontSize="12"/></Expander.Header><ScrollViewer x:Name="ComposerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220"><StackPanel Margin="0,6,4,0">
        <DockPanel><TextBlock Text="场景" VerticalAlignment="Center" Margin="0,0,12,8"/><ComboBox x:Name="WorkspaceScene" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="WorkspaceScene_SelectionChanged" Focusable="False" AutomationProperties.Name="当前场景" ToolTip="鼠标选择场景，保持原窗口焦点；键盘配置场景请打开设置。"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="Focusable" Value="False"/></Style></ComboBox.ItemContainerStyle></ComboBox></DockPanel>
        <Border x:Name="Attachment" Visibility="Collapsed" Background="{DynamicResource Surface}" Padding="8" Margin="0,0,0,8"><StackPanel>
          <DockPanel Margin="0,0,0,4"><Button x:Name="ClearInputButton" DockPanel.Dock="Right" Content="清空队列" Padding="6,1" Margin="0" Click="RemoveInput_Click" Focusable="False"/><TextBlock x:Name="QueueCount" VerticalAlignment="Center" FontSize="12"/></DockPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="110"><ItemsControl x:Name="InputQueue"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="150" Margin="0,0,10,0"><DockPanel><Button Content="移除" Tag="{Binding Id}" local:ShortcutHint.Text="{Binding RemoveHint}" local:ShortcutHint.Description="{Binding RemoveDescription}" ToolTip="{Binding RemoveDescription}" DockPanel.Dock="Right" Padding="4,0" Margin="4,0,0,0" FontSize="11" Focusable="False" Click="RemoveInput_Click"/><TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel><Image Source="{Binding Thumbnail}" Visibility="{Binding ImageVisibility}" Height="40" Stretch="Uniform" HorizontalAlignment="Left"/><TextBlock Text="{Binding Summary}" FontSize="11" MaxHeight="28" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></Expander>
<WrapPanel Grid.Row="1"><Button x:Name="SendButton" Content="发送" Style="{StaticResource WorkspacePrimary}" Click="Send_Click" Focusable="False"/><Button x:Name="ScreenSendButton" Content="截屏并发送" Style="{StaticResource WorkspacePrimary}" ToolTip="截取鼠标所在显示器，仅发送本次截图，使用当前场景与模型；成功后单独开始一题，替换旧队列和问题。采集时临时隐藏 Superb；若当前有焦点，Windows 会转移焦点。" Click="ScreenSend_Click" Focusable="False"/><Button x:Name="ClipboardButton" Content="读剪贴板" Click="Clipboard_Click" Focusable="False"/><Button x:Name="CaptureButton" Content="两点截图" ToolTip="选点不会激活底层窗口。采集时临时隐藏 Superb；若 Superb 当前有焦点，Windows 会转移焦点。建议先点击目标应用，再用截图快捷键。" Click="Capture_Click" Focusable="False"/><Button x:Name="ScreenButton" Content="截当前屏" ToolTip="采集时临时隐藏 Superb；若 Superb 当前有焦点，Windows 会转移焦点。建议先点击目标应用，再用截图快捷键。" Click="Screen_Click" Focusable="False"/><Button x:Name="StopButton" Visibility="Collapsed" Content="停止生成" Click="Stop_Click" IsEnabled="False" Focusable="False"/></WrapPanel>

<Border x:Name="AnswerSurface" Grid.Row="3" ClipToBounds="True" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,4" Margin="0,2,0,6"><Grid><TextBlock x:Name="EmptyAnswer" Text="选择场景，读取剪贴板或收集截图。&#10;确认队列后发送。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/><local:AnswerView x:Name="Answer" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" FontSize="18" ToolTip="文字区的点击与滚轮穿透到下层窗口；使用滚动条或翻页快捷键阅读，点击复制按钮获取完整回答。"/></Grid></Border>

</Grid>
<StackPanel Grid.Row="4"><WrapPanel><Button x:Name="CopyButton" Visibility="Collapsed" Content="复制回答" Click="Copy_Click" IsEnabled="False" Focusable="False"/><Button x:Name="RetryButton" Visibility="Collapsed" Content="重答" ToolTip="沿用上次冻结的输入、场景、模型、token 上限和思考设置；修改设置后请使用发送" Click="Retry_Click" IsEnabled="False" Focusable="False"/><Button x:Name="DirectRetryButton" Content="直接回答重试" Visibility="Collapsed" ToolTip="仅这次重试关闭 DeepSeek 深度思考，可能产生新的用量；保持上次输入、模型、token 上限与保护规则，不修改保存的设置" Click="DirectRetry_Click" Focusable="False"/><Button Content="新任务" Click="NewTask_Click" Focusable="False"/><Button x:Name="ThroughButton" Content="全穿透" ToolTip="连按钮也穿透到下层窗口；使用穿透快捷键恢复操作。不自动转移键盘焦点。" Click="Through_Click" Focusable="False"/><Button x:Name="PauseButton" Content="暂停" ToolTip="暂停会取消任务、停止同步并清空草稿、队列与回答；保持当前焦点。恢复不会找回已清空内容或续接请求。" Click="Pause_Click" Focusable="False"/></WrapPanel><DockPanel><Thumb x:Name="ResizeHandle" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" DockPanel.Dock="Right" Width="24" Height="20" Cursor="Arrow" ForceCursor="True" DragDelta="ResizeHandle_DragDelta" AutomationProperties.Name="拖动调整浮窗大小" ToolTip="拖动调整大小，保持普通箭头和原窗口焦点。"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><TextBlock Text="◢" Foreground="{DynamicResource Muted}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border></ControlTemplate></Thumb.Template></Thumb><TextBlock x:Name="ProtectionStatus" Text="保护未验证" Visibility="Collapsed" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></StackPanel>
</Grid></Border></Window>

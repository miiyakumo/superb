<Window x:Class="Superb.Desktop.ReaderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Superb.Desktop" Style="{StaticResource {x:Type Window}}" Title="Superb" Width="600" Height="740" MinWidth="360" MinHeight="480" MaxWidth="1800" MaxHeight="1600" AllowsTransparency="True" ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStyle="None" ResizeMode="NoResize" Background="Transparent" PreviewKeyDown="Window_PreviewKeyDown">
<Window.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,3"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="Margin" Value="0,0,2,2"/><Setter Property="FontSize" Value="12"/></Style><Style x:Key="WorkspacePrimary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Padding" Value="8,3"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="Margin" Value="0,0,2,2"/><Setter Property="FontSize" Value="12"/></Style><Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="MinWidth" Value="18"/><Setter Property="MinHeight" Value="18"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Focusable" Value="False"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Width="18" Height="18" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="ScrollViewer"><Setter Property="Focusable" Value="False"/></Style><Style TargetType="Thumb"><Setter Property="Focusable" Value="False"/></Style><Style TargetType="ToggleButton"><Setter Property="Focusable" Value="False"/></Style></Window.Resources>
<Border x:Name="WindowSurface" Background="{DynamicResource Base}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10"><Grid x:Name="WorkspaceRoot"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel x:Name="DragHeader" ToolTip="拖动标题移动浮窗，保持原窗口焦点。" MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><Button x:Name="InteractionButton" Content="编辑" Click="Interaction_Click" Focusable="False"/><Button x:Name="AppearanceButton" Content="外观" ToolTip="调整外观可能使原窗口失去焦点；完成后请点击原窗口继续。" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Click="Appearance_Click" Focusable="False"/><Button x:Name="SettingsButton" Content="设置" ToolTip="显示设置不抢焦点；点击设置窗口进行配置会使原窗口失焦。" Click="Settings_Click" Focusable="False"/><Button x:Name="HideButton" Content="收起" ToolTip="收起浮窗；若浮窗当前有焦点，Windows 会把焦点转给其他窗口。" Click="Hide_Click" Focusable="False"/></WrapPanel>
        <Grid VerticalAlignment="Center" Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="240"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="StateText" TextWrapping="NoWrap" Text="等待输入" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="·" Margin="6,0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="ReceiverText" TextWrapping="NoWrap" Grid.Column="2" Text="先连接模型" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/></Grid>
      </DockPanel>
<TextBlock x:Name="ModeHint" Grid.Row="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Text="阅读模式 · 点击输入会使原窗口失焦" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,6"/>

<Border x:Name="AppearancePanel" Grid.Row="2" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="0,6" Margin="0,0,0,6"><ScrollViewer x:Name="AppearanceScroll" VerticalScrollBarVisibility="Auto" MaxHeight="220" ToolTip="调整外观可能使原窗口失去焦点；完成后请点击原窗口继续。"><StackPanel><TextBlock x:Name="AppearanceFocusNotice" Text="调整外观可能使原窗口失焦；完成后请点击原窗口继续。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8"/><TextBlock Text="配色" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/><WrapPanel><Button x:Name="ThemeInk" Content="墨" Tag="ink" Click="ThemePreset_Click" Focusable="False" ToolTip="近黑阅读面"/><Button x:Name="ThemeMist" Content="雾" Tag="mist" Click="ThemePreset_Click" Focusable="False" ToolTip="较亮的深色阅读面"/><Button x:Name="ThemePaper" Content="纸" Tag="paper" Click="ThemePreset_Click" Focusable="False" ToolTip="浅色阅读面"/><Button x:Name="ThemePine" Content="松绿" Tag="pine" Click="ThemePreset_Click" Focusable="False" ToolTip="原来的绿色阅读面"/></WrapPanel><TextBlock Text="强调色" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,4"/><WrapPanel x:Name="AccentSwatches"><Button Style="{StaticResource Swatch}" Background="#8AB4F8" Tag="#8AB4F8" Click="Accent_Click" ToolTip="#8AB4F8"/><Button Style="{StaticResource Swatch}" Background="#7DCEA0" Tag="#7DCEA0" Click="Accent_Click" ToolTip="#7DCEA0"/><Button Style="{StaticResource Swatch}" Background="#E0B15A" Tag="#E0B15A" Click="Accent_Click" ToolTip="#E0B15A"/><Button Style="{StaticResource Swatch}" Background="#E08B8B" Tag="#E08B8B" Click="Accent_Click" ToolTip="#E08B8B"/><Button Style="{StaticResource Swatch}" Background="#C6A4E8" Tag="#C6A4E8" Click="Accent_Click" ToolTip="#C6A4E8"/><Button Style="{StaticResource Swatch}" Background="#8FD0D6" Tag="#8FD0D6" Click="Accent_Click" ToolTip="#8FD0D6"/><Button Style="{StaticResource Swatch}" Background="#E6E8EB" Tag="#E6E8EB" Click="Accent_Click" ToolTip="#E6E8EB"/><Button Style="{StaticResource Swatch}" Background="#5F6368" Tag="#5F6368" Click="Accent_Click" ToolTip="#5F6368"/></WrapPanel><Expander Header="自定义颜色" Margin="0,0,0,8"><StackPanel Margin="0,6,0,0"><TextBlock Text="背景和文字填 #RRGGBB，强调可留空。输入颜色会使原窗口失焦。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="背景" FontSize="12"/><TextBox x:Name="CustomBaseBox" ToolTip="例如 #131416"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="文字" FontSize="12"/><TextBox x:Name="CustomInkBox" ToolTip="例如 #E8EAED"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="强调" FontSize="12"/><TextBox x:Name="CustomAccentBox" ToolTip="例如 #8AB4F8"/></StackPanel></Grid><Button x:Name="ApplyCustomButton" Content="应用颜色" Click="ApplyCustom_Click" Focusable="False" HorizontalAlignment="Left"/><TextBlock x:Name="ThemeError" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/></StackPanel></Expander><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="{Binding ElementName=PanelWidth, Path=Value, StringFormat=宽度 {0:F0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelWidth" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="0" Grid.Column="1" Minimum="360" Maximum="1800" Value="600" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="浮窗宽度" ToolTip="拖动调整宽度，无需进入编辑；调整可能使原窗口失去焦点。"/>
<TextBlock Grid.Row="1" Text="{Binding ElementName=PanelHeight, Path=Value, StringFormat=高度 {0:F0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelHeight" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="1" Grid.Column="1" Minimum="480" Maximum="1600" Value="740" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="浮窗高度" ToolTip="拖动调整高度，无需进入编辑；调整可能使原窗口失去焦点。"/>
<TextBlock Grid.Row="2" Text="{Binding ElementName=PanelOpacity, Path=Value, StringFormat=不透明 {0:P0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelOpacity" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="2" Grid.Column="1" Minimum="0.25" Maximum="1" Value="1" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="浮窗背景不透明度" ToolTip="向右更不透明，文字保持实色，无需进入编辑；调整可能使原窗口失去焦点。"/>
<TextBlock Grid.Row="3" Text="{Binding ElementName=PanelTextSize, Path=Value, StringFormat=字号 {0:F0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelTextSize" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="3" Grid.Column="1" Minimum="11" Maximum="36" Value="18" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="回答字号" ToolTip="拖动调整字号，无需进入编辑；调整可能使原窗口失去焦点。"/></Grid><WrapPanel Margin="0,4,0,0"><Button x:Name="ComfortableButton" Content="舒适阅读" ToolTip="应用舒适阅读布局；调整可能使原窗口失去焦点，完成后请点击原窗口继续。" Click="Comfortable_Click" Focusable="False"/><Button x:Name="ResetAppearanceButton" Content="恢复默认" ToolTip="恢复默认外观；调整可能使原窗口失去焦点，完成后请点击原窗口继续。" Click="ResetAppearance_Click" Focusable="False"/></WrapPanel></StackPanel></ScrollViewer></Border>
<Grid x:Name="WorkArea" Grid.Row="3" SizeChanged="WorkArea_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Expander x:Name="ComposerExpander" IsExpanded="True" Margin="0,0,0,6"><Expander.Header><TextBlock x:Name="InputHeading" Text="输入与队列" FontSize="12"/></Expander.Header><ScrollViewer x:Name="ComposerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220"><StackPanel Margin="0,6,4,0">
        <DockPanel><TextBlock Text="场景" VerticalAlignment="Center" Margin="0,0,12,8"/><ComboBox x:Name="WorkspaceScene" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="WorkspaceScene_SelectionChanged" Focusable="False" AutomationProperties.Name="当前场景" ToolTip="鼠标选择场景，保持原窗口焦点；键盘配置场景请打开设置。"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="Focusable" Value="False"/></Style></ComboBox.ItemContainerStyle></ComboBox></DockPanel>
        <TextBlock x:Name="DraftFocusNotice" Text="点击输入会使原窗口失焦；完成后请点击原窗口继续。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/><TextBox x:Name="DraftText" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="110" VerticalScrollBarVisibility="Auto" TextChanged="DraftText_TextChanged" PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown" AutomationProperties.Name="本次问题或补充要求" ToolTip="输入和输入法必须取得键盘焦点，会使原窗口失焦；Ctrl+Enter 发送。Esc 仅结束编辑，不自动返回原窗口。"/>
        <Border x:Name="Attachment" Visibility="Collapsed" Background="{DynamicResource Surface}" Padding="8" Margin="0,0,0,8"><StackPanel>
          <DockPanel Margin="0,0,0,4"><Button x:Name="ClearInputButton" DockPanel.Dock="Right" Content="清空队列" Padding="6,1" Margin="0" Click="RemoveInput_Click" Focusable="False"/><TextBlock x:Name="QueueCount" VerticalAlignment="Center" FontSize="12"/></DockPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="110"><ItemsControl x:Name="InputQueue"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="150" Margin="0,0,10,0"><DockPanel><Button Content="移除" Tag="{Binding Id}" local:ShortcutHint.Text="{Binding RemoveHint}" local:ShortcutHint.Description="{Binding RemoveDescription}" ToolTip="{Binding RemoveDescription}" DockPanel.Dock="Right" Padding="4,0" Margin="4,0,0,0" FontSize="11" Focusable="False" Click="RemoveInput_Click"/><TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel><Image Source="{Binding Thumbnail}" Visibility="{Binding ImageVisibility}" Height="40" Stretch="Uniform" HorizontalAlignment="Left"/><TextBlock Text="{Binding Summary}" FontSize="11" MaxHeight="28" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></Expander>
<WrapPanel Grid.Row="1"><Button x:Name="SendButton" Content="发送" Style="{StaticResource WorkspacePrimary}" Click="Send_Click" Focusable="False"/><Button x:Name="ClipboardButton" Content="读剪贴板" Click="Clipboard_Click" Focusable="False"/><Button x:Name="CaptureButton" Content="两点截图" ToolTip="选点不会激活底层窗口。采集时临时隐藏 Superb；若 Superb 当前有焦点，Windows 会转移焦点。建议先点击目标应用，再用截图快捷键。" Click="Capture_Click" Focusable="False"/><Button x:Name="ScreenButton" Content="截当前屏" ToolTip="采集时临时隐藏 Superb；若 Superb 当前有焦点，Windows 会转移焦点。建议先点击目标应用，再用截图快捷键。" Click="Screen_Click" Focusable="False"/><Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Focusable="False"/></WrapPanel>

<Border x:Name="AnswerSurface" Grid.Row="2" ClipToBounds="True" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,4" Margin="0,2,0,6"><Grid><TextBlock x:Name="EmptyAnswer" Text="选择场景，输入问题或收集截图、剪贴板。&#10;确认队列后发送。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/><local:AnswerView x:Name="Answer" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" FontSize="18" ToolTip="阅读、翻页和滚动保持原窗口焦点；编辑模式下拖选文字需要焦点，会使原窗口失焦。可用“复制回答”避免切换。"/></Grid></Border>

</Grid>
<StackPanel Grid.Row="4"><WrapPanel><Button x:Name="CopyButton" Content="复制回答" Click="Copy_Click" IsEnabled="False" Focusable="False"/><Button x:Name="RetryButton" Content="重答" ToolTip="沿用上次冻结的输入、场景、模型、token 上限和思考设置；修改设置后请使用发送" Click="Retry_Click" IsEnabled="False" Focusable="False"/><Button x:Name="DirectRetryButton" Content="直接回答重试" Visibility="Collapsed" ToolTip="仅这次重试关闭 DeepSeek 深度思考，可能产生新的用量；保持上次输入、模型、token 上限与保护规则，不修改保存的设置" Click="DirectRetry_Click" Focusable="False"/><Button Content="新任务" Click="NewTask_Click" Focusable="False"/><Button x:Name="ThroughButton" Content="穿透" ToolTip="只把鼠标操作交给底层窗口，不自动转移键盘焦点；请点击目标应用继续输入。" Click="Through_Click" Focusable="False"/><Button x:Name="PauseButton" Content="暂停" ToolTip="暂停会取消任务、停止同步并清空草稿、队列与回答；保持当前焦点。恢复不会找回已清空内容或续接请求。" Click="Pause_Click" Focusable="False"/></WrapPanel><DockPanel><Thumb x:Name="ResizeHandle" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" DockPanel.Dock="Right" Width="24" Height="20" Cursor="SizeNWSE" DragDelta="ResizeHandle_DragDelta" AutomationProperties.Name="拖动调整浮窗大小" ToolTip="拖动调整大小，无需进入编辑；调整可能使原窗口失去焦点。"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><TextBlock Text="◢" Foreground="{DynamicResource Muted}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border></ControlTemplate></Thumb.Template></Thumb><TextBlock x:Name="ProtectionStatus" Text="保护未验证" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></StackPanel>
</Grid></Border></Window>

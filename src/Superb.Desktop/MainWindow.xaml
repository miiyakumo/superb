<Window x:Class="Superb.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Superb.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="Superb · 设置" Width="900" Height="820" MinWidth="800" MinHeight="680" ShowActivated="False" WindowStartupLocation="CenterScreen">
  <Window.Resources><Style x:Key="SettingsSecondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/></Style><Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="MinWidth" Value="18"/><Setter Property="MinHeight" Value="18"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Focusable" Value="False"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Width="18" Height="18" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Padding="4" Background="{TemplateBinding Background}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Line}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel LastChildFill="True" Background="{DynamicResource Surface}"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Margin="0" Padding="14,4" ToolTip="最小化" Focusable="False" Click="MinimizeSettings_Click"/><Button Content="□" Margin="0" Padding="14,4" ToolTip="最大化 / 还原" Focusable="False" Click="MaximizeSettings_Click"/><Button x:Name="SettingsCloseButton" Content="×" Margin="0" Padding="14,4" ToolTip="收起设置，工作区继续运行。退出程序请使用下方“退出 Superb”。" AutomationProperties.Name="收起设置" Focusable="False" Click="HideControl_Click"/></StackPanel><TextBlock Text="Superb · 设置" Margin="12,0" VerticalAlignment="Center"/></DockPanel>
  <Grid Grid.Row="1" Margin="24,16,24,24">

    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="SettingsStatusCard" Visibility="Collapsed" Background="{DynamicResource Surface}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
      <StackPanel><TextBlock x:Name="ModeLabel" Text="正在初始化" FontWeight="SemiBold"/><TextBlock x:Name="StatusLabel" Text="正在检查显示保护。" Style="{StaticResource Hint}" Margin="0,4,0,0"/><Expander x:Name="ErrorDetails" Header="诊断详情" Visibility="Collapsed" Margin="0,6,0,0"><TextBlock x:Name="ErrorCode" Style="{StaticResource Hint}"/></Expander></StackPanel>
    </Border>
    <TabControl x:Name="MainTabs" Grid.Row="1" Background="{DynamicResource Base}" BorderThickness="0">
      <TabControl.Tag>
        <StackPanel x:Name="SettingsHeaderActions" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><Button x:Name="ReturnWorkspaceButton" Content="返回工作区" ToolTip="收起设置并显示浮窗；若设置当前有焦点，Windows 会转移焦点。" Style="{StaticResource Primary}" Margin="0,0,8,0" Click="ShowPanel_Click"/><Button x:Name="ResumeButton" Content="恢复" Focusable="False" Margin="0" ToolTip="检查会话和保护后恢复使用，保持当前焦点；不会恢复已清空的内容或续接请求。" Click="Resume_Click" Visibility="Collapsed"/><Button x:Name="SettingsPauseButton" Content="暂停" Focusable="False" Margin="0" ToolTip="取消任务、停止同步并清空队列与回答；保持当前焦点。" Click="Pause_Click"/></StackPanel>
      </TabControl.Tag>
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel LastChildFill="True"><ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Tag}"/><TabPanel IsItemsHost="True" VerticalAlignment="Center" KeyboardNavigation.TabIndex="1"/></DockPanel>
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem x:Name="ConnectionTab" Header="模型"><Grid Margin="8,18,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
          <TextBlock Text="模型连接" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
          <TextBlock x:Name="ModelSummary" Style="{StaticResource Hint}"/>
          <StackPanel x:Name="SavedConnections">
            <TextBlock Text="已保存的连接"/>
            <ListBox x:Name="EditBackendPicker" MinHeight="100" MaxHeight="250" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" SelectionChanged="EditBackendPicker_SelectionChanged" AutomationProperties.Name="模型连接列表">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Model}" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock Text="默认" FontSize="11" Foreground="{DynamicResource Accent}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="SetDefaultModelButton" Content="设为默认" Style="{StaticResource SettingsSecondary}" HorizontalAlignment="Left" Click="SetDefaultBackend_Click" IsEnabled="False"/>
            <Button x:Name="DeleteModelButton" Content="删除配置" Style="{StaticResource SettingsSecondary}" HorizontalAlignment="Left" Click="DeleteBackend_Click" IsEnabled="False"/>
          </StackPanel>
          <TextBlock Text="新建连接模板" Margin="0,16,0,0"/>
          <ComboBox x:Name="ConnectionPresetPicker" SelectedIndex="0" AutomationProperties.Name="新建连接模板"><ComboBoxItem Content="自定义 / OpenAI 兼容"/><ComboBoxItem Content="OpenAI 官方"/><ComboBoxItem Content="DeepSeek 官方"/><ComboBoxItem Content="本机兼容服务"/></ComboBox>
          <Button x:Name="NewModelButton" Content="新建模型配置" Style="{StaticResource SettingsSecondary}" HorizontalAlignment="Left" Click="NewBackend_Click"/>
          <TextBlock Text="选择模板并新建，在右侧填写连接信息；已有配置可从上方选择编辑。" Style="{StaticResource Hint}"/>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="ModelEditorScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource Ink}"><StackPanel x:Name="BackendSettings" Margin="0,0,8,0">
          <TextBlock x:Name="ModelEditorHeading" Text="新建模型配置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="支持 OpenAI Chat Completions 兼容服务。" ToolTip="支持官方服务、第三方网关和本机服务的 OpenAI Chat Completions 协议。模板用于填入地址；名称、模型和参数均可修改。" Style="{StaticResource Hint}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="配置名称（必填）"/><TextBox x:Name="BackendName" AutomationProperties.Name="配置名称"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="模型 ID（必填）"/><ComboBox x:Name="ModelName" IsEditable="True" AutomationProperties.Name="模型 ID"/></StackPanel></Grid>
          <TextBlock Text="服务地址 URL（必填）"/><TextBox x:Name="Endpoint" TextChanged="Endpoint_TextChanged" AutomationProperties.Name="模型服务地址 URL"/>
          <TextBlock Text="支持服务根地址、/v1 或完整接口地址。" ToolTip="可填 https://服务地址/v1 或完整的 /chat/completions 地址；域名和 /v1 会自动补全路径。自定义网关请填写完整 POST 地址。" Style="{StaticResource Hint}"/>
          <TextBlock Text="API 密钥"/><PasswordBox x:Name="ApiKey" AutomationProperties.Name="模型 API 密钥"/>
          <TextBlock x:Name="ApiKeyHint" Text="按服务要求填写；无认证的本机服务可留空。密钥加密保存在当前 Windows 用户下。" Style="{StaticResource Hint}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="最大生成 tokens（必填）"/><TextBox x:Name="MaxTokens" Text="200000"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="超时秒数（必填，1–600）"/><TextBox x:Name="TimeoutSeconds" Text="300"/></StackPanel></Grid>
          <TextBlock Text="生成预算包含思考与正文，按模型上限调整。" ToolTip="生成预算包含思考与正文；默认 200000，需按服务的实际上限调整。参数被拒绝时请调低预算，或在高级选项中修改参数名称。保存后重新发送生效。" Style="{StaticResource Hint}"/>
          <StackPanel x:Name="ThinkingSettings" Visibility="Collapsed"><TextBlock Text="思考模式（DeepSeek 官方接口）"/><ComboBox x:Name="ThinkingModePicker" SelectedIndex="0"><ComboBoxItem Content="沿用模型默认"/><ComboBoxItem Content="直接回答（关闭深度思考）"/><ComboBoxItem Content="深度思考"/></ComboBox><TextBlock Text="此开关仅用于 DeepSeek 官方接口；其他服务沿用模型默认行为。" Style="{StaticResource Hint}"/></StackPanel>
          <TextBlock Text="测试当前表单，可能产生少量费用，不会保存。" ToolTip="测试使用当前表单（含未保存的修改和密钥），发送固定文本 Reply with OK.，可能产生少量费用；测试不会保存配置。" Style="{StaticResource Hint}"/>
          <Expander x:Name="BackendAdvancedSettings" Header="高级选项 · 代理、能力与生成参数" Margin="0,0,0,16"><StackPanel Margin="8,12,8,0">
            <TextBlock Text="网络代理"/><ComboBox x:Name="ProxyModePicker" SelectedIndex="0"><ComboBoxItem Content="直连（不使用代理）"/><ComboBoxItem Content="系统代理（环境变量 / Windows 用户代理）"/><ComboBoxItem Content="自定义代理"/></ComboBox>
            <TextBlock Text="自定义代理地址（仅自定义模式使用）"/><TextBox x:Name="ProxyAddressBox"/>
            <TextBlock Text="例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7891。失败不自动切换线路。" Style="{StaticResource Hint}"/>
            <WrapPanel><CheckBox x:Name="Vision" Content="支持图像输入" Margin="0,6,24,10"/><CheckBox x:Name="Streaming" Content="流式输出" IsChecked="True" Margin="0,6,24,10"/><CheckBox x:Name="Loopback" Content="允许本机 IP 回环 HTTP"/></WrapPanel>
            <TextBlock Text="温度（0–2）"/><TextBox x:Name="Temperature" Text="0.2"/>
            <CheckBox x:Name="SendTemperature" Content="发送 temperature 参数" IsChecked="True"/>
            <CheckBox x:Name="UseCompletionTokens" Content="使用 max_completion_tokens（替代 max_tokens）"/>
            <TextBlock Text="部分推理模型需关闭 temperature，并使用 max_completion_tokens。图像和流式能力须与模型服务一致。" Style="{StaticResource Hint}"/>
          </StackPanel></Expander>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0"><StackPanel>
          <WrapPanel><Button x:Name="SaveModelButton" Content="保存模型配置" Style="{StaticResource Primary}" Click="SaveBackend_Click"/><Button x:Name="TestBackendButton" Content="测试当前配置" Style="{StaticResource SettingsSecondary}" Click="TestBackend_Click"/><Button x:Name="CancelProbeButton" Content="取消测试" Style="{StaticResource SettingsSecondary}" Click="CancelProbe_Click" Visibility="Collapsed"/></WrapPanel>
          <TextBlock x:Name="ConnectionStatus" Text="填写配置后可直接测试，确认后保存。" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
        </StackPanel></Border>
      </Grid></TabItem>
      <TabItem x:Name="ScenesTab" Header="场景"><Grid x:Name="SceneSettings" Margin="8,18,8,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="场景与提示词" Style="{StaticResource Heading}"/>
        <ScrollViewer x:Name="SceneEditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,0,8,0">
                    <ComboBox x:Name="ScenePicker" DisplayMemberPath="Name" SelectionChanged="ScenePicker_SelectionChanged"/>
          <WrapPanel><Button Content="新建场景" Click="NewScene_Click"/><Button Content="删除场景" Click="DeleteScene_Click"/></WrapPanel>
          <TextBlock Text="名称"/><TextBox x:Name="SceneName"/>
          <TextBlock Text="系统提示词"/><TextBox x:Name="SceneSystemPrompt" AcceptsReturn="True" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

          <TextBlock Text="模型连接（可选）"/><ComboBox x:Name="SceneBackendPicker" DisplayMemberPath="Label" SelectedValuePath="Id"/>
          <TextBlock Text="未指定时使用当前默认连接。模型和生成参数在“模型”页配置；需要不同参数时，新建模型配置。" Style="{StaticResource Hint}"/>
          <TextBlock Text="场景切换提示词，使用当前工作区输入。" ToolTip="输入正文直接附加，任务说明放在系统提示词中。一键快捷键切换场景，使用当前工作区输入与截图队列；发起键在“快捷键”页配置。输入正文不会保存。" Style="{StaticResource Hint}"/>
          <TextBlock x:Name="SceneTriggerSummary" Style="{StaticResource Hint}"/>
          <Expander Header="恢复内置预设" Margin="0,0,0,16"><WrapPanel Margin="8,12,8,0"><Button Content="恢复当前预设内容" Click="RestoreScene_Click"/><Button Content="补回缺失的内置场景" Click="RestoreMissingScenes_Click"/></WrapPanel></Expander>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="SaveSceneButton" Content="保存场景" Style="{StaticResource Primary}" Click="SaveScene_Click"/><Button x:Name="OpenHotkeysButton" Content="配置发起键" Click="OpenHotkeys_Click"/></WrapPanel>
      </Grid></TabItem>
      <TabItem x:Name="ShortcutsTab" Header="快捷键"><Grid x:Name="HotkeySettings" Margin="8,18,8,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="快捷键" Style="{StaticResource Heading}"/><TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}"/>
          <TextBlock Text="按行启用；右键按键可配置独占模式。" Style="{StaticResource Hint}" ToolTip="独占单键可选 F1–F11、F13–F24，按下和释放均由 Superb 消费。组合键的修饰键可能传给原应用。重复绑定阻止保存；注册失败会列出动作。请松开按键后再保存或退出。"/>
          <Grid Margin="0,0,24,8"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="状态"/><TextBlock Grid.Column="1" Text="动作"/><TextBlock Grid.Column="2" Text="按键"/></Grid>
        </StackPanel>
        <ScrollViewer x:Name="HotkeyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Ink}">        <ItemsControl x:Name="HotkeyRows"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <CheckBox Content="启用" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
          <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,10,10"/>
          <TextBox Grid.Column="2" Text="{Binding Gesture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入按键；右键或 Shift+F10 可切换独占模式。"><TextBox.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="独占单键" IsCheckable="True" IsChecked="{Binding IsExclusive, Mode=TwoWay}"/></ContextMenu></TextBox.ContextMenu></TextBox>
        </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</ScrollViewer>
        <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="SaveHotkeysButton" Content="保存快捷键" Style="{StaticResource Primary}" Click="SaveHotkeys_Click"/><Button Content="填入默认绑定" Click="ResetHotkeys_Click"/></WrapPanel>
      </Grid></TabItem>
      <TabItem x:Name="AppearanceTab" Header="外观"><ScrollViewer x:Name="AppearanceScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AppearancePanel" Margin="8,18,16,0"><TextBlock Text="外观" Style="{StaticResource Heading}"/><TextBlock x:Name="AppearanceFocusNotice" Text="调整即时预览并自动保存。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8"/><TextBlock Text="配色" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/><WrapPanel><Button x:Name="ThemeInk" Content="墨" Tag="ink" Click="ThemePreset_Click" Focusable="False" ToolTip="近黑阅读面"/><Button x:Name="ThemeMist" Content="雾" Tag="mist" Click="ThemePreset_Click" Focusable="False" ToolTip="较亮的深色阅读面"/><Button x:Name="ThemePaper" Content="纸" Tag="paper" Click="ThemePreset_Click" Focusable="False" ToolTip="浅色阅读面"/><Button x:Name="ThemePine" Content="松绿" Tag="pine" Click="ThemePreset_Click" Focusable="False" ToolTip="原来的绿色阅读面"/></WrapPanel><TextBlock Text="强调色" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,4"/><WrapPanel x:Name="AccentSwatches"><Button Style="{StaticResource Swatch}" Background="#8AB4F8" Tag="#8AB4F8" Click="Accent_Click" ToolTip="#8AB4F8"/><Button Style="{StaticResource Swatch}" Background="#7DCEA0" Tag="#7DCEA0" Click="Accent_Click" ToolTip="#7DCEA0"/><Button Style="{StaticResource Swatch}" Background="#E0B15A" Tag="#E0B15A" Click="Accent_Click" ToolTip="#E0B15A"/><Button Style="{StaticResource Swatch}" Background="#E08B8B" Tag="#E08B8B" Click="Accent_Click" ToolTip="#E08B8B"/><Button Style="{StaticResource Swatch}" Background="#C6A4E8" Tag="#C6A4E8" Click="Accent_Click" ToolTip="#C6A4E8"/><Button Style="{StaticResource Swatch}" Background="#8FD0D6" Tag="#8FD0D6" Click="Accent_Click" ToolTip="#8FD0D6"/><Button Style="{StaticResource Swatch}" Background="#E6E8EB" Tag="#E6E8EB" Click="Accent_Click" ToolTip="#E6E8EB"/><Button Style="{StaticResource Swatch}" Background="#5F6368" Tag="#5F6368" Click="Accent_Click" ToolTip="#5F6368"/></WrapPanel><Expander Header="自定义颜色" Margin="0,0,0,8"><StackPanel Margin="0,6,0,0"><TextBlock Text="背景和文字填 #RRGGBB，强调可留空。输入颜色会使原窗口失焦。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="背景" FontSize="12"/><TextBox x:Name="CustomBaseBox" ToolTip="例如 #131416"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="文字" FontSize="12"/><TextBox x:Name="CustomInkBox" ToolTip="例如 #E8EAED"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="强调" FontSize="12"/><TextBox x:Name="CustomAccentBox" ToolTip="例如 #8AB4F8"/></StackPanel></Grid><Button x:Name="ApplyCustomButton" Content="应用颜色" Click="ApplyCustom_Click" Focusable="False" HorizontalAlignment="Left"/><TextBlock x:Name="ThemeError" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/></StackPanel></Expander><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="{Binding ElementName=PanelWidth, Path=Value, StringFormat=宽度 {0:F0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelWidth" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="0" Grid.Column="1" Minimum="360" Maximum="1800" Value="600" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="浮窗宽度" ToolTip="拖动调整宽度，无需进入编辑；调整可能使原窗口失去焦点。"/>
<TextBlock Grid.Row="1" Text="{Binding ElementName=PanelHeight, Path=Value, StringFormat=高度 {0:F0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelHeight" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="1" Grid.Column="1" Minimum="480" Maximum="1600" Value="740" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="浮窗高度" ToolTip="拖动调整高度，无需进入编辑；调整可能使原窗口失去焦点。"/>
<TextBlock Grid.Row="2" Text="{Binding ElementName=PanelOpacity, Path=Value, StringFormat=不透明 {0:P0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelOpacity" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="2" Grid.Column="1" Minimum="0.25" Maximum="1" Value="1" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="浮窗背景不透明度" ToolTip="向右更不透明，文字保持实色，无需进入编辑；调整可能使原窗口失去焦点。"/>
<TextBlock Grid.Row="3" Text="{Binding ElementName=PanelTextSize, Path=Value, StringFormat=字号 {0:F0}}" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="PanelTextSize" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" Grid.Row="3" Grid.Column="1" Minimum="11" Maximum="36" Value="18" Margin="8,3,0,3" Focusable="False" ValueChanged="Appearance_ValueChanged" AutomationProperties.Name="回答字号" ToolTip="拖动调整字号，无需进入编辑；调整可能使原窗口失去焦点。"/></Grid><WrapPanel Margin="0,4,0,0"><Button x:Name="ComfortableButton" Content="舒适阅读" ToolTip="应用舒适阅读布局。" Click="Comfortable_Click" Focusable="False"/><Button x:Name="ResetAppearanceButton" Content="恢复默认" ToolTip="恢复默认尺寸、字号与配色。" Click="ResetAppearance_Click" Focusable="False"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="AdvancedTab" Header="通用"><ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Ink}"><StackPanel Margin="8,18,8,0">
        <TextBlock Text="剪贴板偏好" Style="{StaticResource Heading}"/>
        <StackPanel x:Name="ClipboardPreferences"><CheckBox x:Name="AutoCopy" Content="完成后自动写回剪贴板（内容被其他应用更新时跳过）"/><CheckBox x:Name="ClearClipboard" Content="暂停、锁屏或退出时，清除仍属于本应用的剪贴板输出"/><Button Content="保存剪贴板偏好" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SavePreferences_Click"/></StackPanel>
        <Expander x:Name="DiagnosticsSettings" Header="诊断与数据保护" Margin="0,24,0,8"><StackPanel Margin="8,8,8,0"><TextBlock x:Name="ProtectionLabel" Text="未验证 / 不支持" Style="{StaticResource Hint}"/><TextBlock Text="不会保存截图、正文或回答；无后台遥测或崩溃上传。模型服务会接收已发送的内容。" Style="{StaticResource Hint}"/></StackPanel></Expander>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,16,0,0"><WrapPanel DockPanel.Dock="Right"><Button x:Name="ExitButton" Content="退出 Superb" ToolTip="关闭 Superb；若其窗口当前有焦点，Windows 会转移焦点。" Click="Exit_Click"/></WrapPanel><TextBlock Text="0.3.0 · 开发版本" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
  </Grid>
  </Grid></Border>
</Window>
